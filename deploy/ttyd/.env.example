# HTTP basic auth for terminal.cloudeasy.site (same user/pass as portal "Terminal sign in")
# Format user:password — used by ttyd -c (nginx auth_basic can match this or be separate)
TTYD_CREDENTIALS=terminal:your-secure-password

# Listen port on the host (nginx proxies terminal.cloudeasy.site → this port)
TTYD_PORT=3000

# To run SSH into the host instead of bash, change docker-compose.yml command to e.g.:
#   ssh -o StrictHostKeyChecking=no ubuntu@127.0.0.1
