# Copy this file to .env and fill in the blanks.
# MongoDB Atlas is the only database. The admin email signs in without OTP.

NODE_ENV=development
APP_URL=http://localhost:3000

MONGODB_URI=

ADMIN_EMAIL=admin@cloudeasy.online

SESSION_SECRET=dev-session-secret-change-me-32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
OTP_PEPPER=dev-otp-pepper
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=true
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=cloudeasy_session

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CloudEasy DevOps Portal <cloudeasydevops@gmail.com>

OPENROUTER_API_KEY=
API_KEY=
OPENROUTER_MODEL=openrouter/free

LOG_LEVEL=debug
LOG_FORMAT=table

AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=cloudeasy
